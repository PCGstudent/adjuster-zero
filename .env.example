# ─────────────────────────────────────────────────────────────────────────────
# Adjuster Zero — environment template.
# Copy to `.env` (agent service) and `web/.env.local` (dashboard) and fill in.
# NEVER commit the filled-in files. All values below are placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# --- Gemini (Google AI Studio) ---------------------------------------------
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Supabase --------------------------------------------------------------
# Project Settings → API. The service-role key bypasses RLS — agent service only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for the agent + LangGraph checkpointer.
# Use the Supabase "Session pooler" (port 5432) connection string.
# Example: postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Observability (optional; tracing is env-gated) ------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=adjuster-zero

# --- Agent service runtime -------------------------------------------------
# Cloud Run injects PORT; default for local dev is 8080.
PORT=8080
# Per-claim token budget enforced by the executor (thesis 6).
CLAIM_TOKEN_BUDGET=120000
# Max replans per claim before forced escalation (thesis 6).
MAX_REPLANS=2

# --- Web (Next.js) — these also belong in web/.env.local -------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the deployed agent service (Cloud Run), or http://localhost:8080 locally.
NEXT_PUBLIC_AGENT_URL=http://localhost:8080
